# Copiar para .env.local e preencher com os valores reais do projeto Supabase
# (Project ref: zyxgultkdkfhruddhbgx). NUNCA colocar a service role key no frontend
# nem em ficheiros commitados no git.

NEXT_PUBLIC_SUPABASE_URL=https://zyxgultkdkfhruddhbgx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só usada em código de servidor (API routes / server actions), nunca no browser
SUPABASE_SERVICE_ROLE_KEY=

# Chave que a IA/n8n deve enviar no header "x-api-key" ao chamar POST /api/casos
CASOS_API_KEY=

# URL do workflow n8n que recebe a resposta pronta quando um caso é concluído
N8N_CASO_CONCLUIDO_WEBHOOK_URL=

# (Opcional, recomendado) Segredo enviado ao n8n no header "x-webhook-secret"
N8N_WEBHOOK_SECRET=
